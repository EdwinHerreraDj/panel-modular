                "summary": "Estado de la API",
                "description": "Comprueba que la API responde y cuántos artículos hay publicados. No pide clave, para poder vigilarla desde fuera.",
                "operationId": "estado",
                "security": [],
                "responses": {
                    "200": {
                        "description": "Correcto",
                        "content": {
                            "application/json": {
                                "example": {
                                    "estado": "ok",
                                    "version": "1.0",
                                    "articulos_publicados": 37,
                                    "hora": "2026-07-31T10:15:00+00:00"
                                }
                            }
                        }
                    }
                }
            }
        },
