{
    "openapi": "3.1.0",
    "info": {
        "title": "API del blog de Alminares Panel",
        "version": "1.0",
        "description": "API de solo lectura para mostrar los artículos del blog en la web pública. Las claves de JSON van en español."
    },
    "servers": [
        {
            "url": "http://localhost:8000/api/v1"
        }
    ],
    "components": {
        "securitySchemes": {
            "ClaveApi": {
                "type": "apiKey",
                "in": "header",
                "name": "X-API-Key",
                "description": "Clave generada desde el panel del blog."
            }
        }
    },
    "security": [
        {
            "ClaveApi": []
        }
