APP_NAME="Panel de Blogs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=area_privada_blog
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# En producción debe ser true (requiere HTTPS)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# `sync` ejecuta los trabajos durante la petición: no hace falta ningún worker.
# Solo cambiar a `database` si se va a dejar corriendo `php artisan queue:work`.
QUEUE_CONNECTION=sync

# --- Biblioteca multimedia -------------------------------------------------
# Disco de almacenamiento; cambiar a s3 no requiere tocar el código
MEDIA_DISK=public
# Procesa las variantes durante la subida, sin worker
MEDIA_QUEUE_CONNECTION=sync

# --- Publicación programada ------------------------------------------------
# Red de seguridad para alojamientos sin cron. Con cron configurado se puede
# poner a false sin perder nada.
ARTICLES_PUBLISH_ON_REQUEST=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@panel-blogs.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Autenticación ---------------------------------------------------------
# Intentos de inicio de sesión permitidos por ventana (email + IP)
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_SECONDS=60
# Longitud mínima de contraseña
AUTH_PASSWORD_MIN_LENGTH=12
# Comprueba la contraseña contra bases de datos públicas de filtraciones
AUTH_PASSWORD_UNCOMPROMISED=true

# --- Cabeceras de seguridad ------------------------------------------------
# Activar solo en producción con HTTPS
SECURITY_HSTS_ENABLED=false

# --- Superadministrador inicial (solo desarrollo) --------------------------
# En producción usa: php artisan panel:crear-superadmin
SEED_SUPER_ADMIN_NAME="Superadministrador"
SEED_SUPER_ADMIN_EMAIL=super@alminares.es
SEED_SUPER_ADMIN_PASSWORD=

# --- API pública -----------------------------------------------------------
# Ruta desde la que se sirve la API
API_PREFIX=api/v1
# Exigir clave para consultarla. Desactívalo solo mientras desarrollas
API_REQUIRE_KEY=true
# Peticiones por minuto y clave
API_RATE_LIMIT=120
# Artículos por página y máximo permitido
API_PER_PAGE=12
API_MAX_PER_PAGE=50
# Dominios que pueden llamar a la API desde el navegador, separados por comas.
# Cada clave puede añadir además los suyos desde el panel.
API_ALLOWED_ORIGINS=

# --- Registros de auditoría ------------------------------------------------
# Días que se conservan los accesos y los cambios (0 = para siempre)
LOGS_RETENTION_DAYS=365
# Limpieza automática al responder, para alojamientos sin cron
LOGS_PRUNE_ON_REQUEST=true

# --- Zona horaria de la base de datos ---------------------------------------
# Debe coincidir con APP_TIMEZONE. Fíjala ANTES de la primera instalación:
# cambiarla con datos ya guardados desplazaría todas las fechas.
DB_TIMEZONE=+00:00

# Módulos activos, separados por comas. Se leen al arrancar y son cacheables
# con `config:cache`, así que no cuestan ninguna consulta.
#
# Activar uno más adelante son tres pasos: añadirlo aquí, `php artisan migrate`
# y sembrar sus permisos. Después, `php artisan config:cache`.
MODULES_ENABLED=
